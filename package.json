{
  "name": "ecolearn-hub",
  "version": "1.0.0",
  "description": "Mobile-first climate learning hub for the EcoLearn SDG 13.3 campaign",
  "main": "backend/server.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon backend/server.js",
    "build": "npm run build --prefix frontend",
    "vercel-build": "npm ci --prefix frontend && npm run build && node scripts/prepare-vercel-build.js",
    "start": "NODE_ENV=production node backend/server.js",
    "seed": "node backend/scripts/seed.js",
    "test": "NODE_ENV=test node --test backend/tests/*.test.js",
    "lint": "npm run lint --prefix frontend",
    "check": "npm test && npm run lint && npm run build"
  },
  "type": "module",
  "keywords": [],
  "author": "EcoLearn Group 5",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongoose": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
